# Casana · web-patron
NEXT_PUBLIC_API_URL=http://localhost:3000

# Llave publicable de Stripe (Elements). Sin ella, el paso de tarjeta permite
# continuar en modo dev.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Firebase / Identity Platform (Google + Apple). Sin estas variables se usa el
# login DEV (solo desarrollo). Config desde el proyecto de Firebase.
# NEXT_PUBLIC_FIREBASE_API_KEY=xxx
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=casana-prod.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=casana-prod
# NEXT_PUBLIC_FIREBASE_APP_ID=1:xxx:web:xxx
